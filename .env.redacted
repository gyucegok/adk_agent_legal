PROJECT_ID="YOUR_PROJECT_ID"
LOCATION="us-central1"
GOOGLE_CLOUD_PROJECT="YOUR_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="1"

# Gemini Enterprise Agent Platform Telemetry
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_SEMCONV_STABILITY_OPT_IN="gen_ai_latest_experimental"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# RAG 2.0 Configuration (Serverless Vector Search 2.0 in us-central1)
LEGAL_CORPUS="sec-legal-contracts-v2"
LEGAL_SOURCE_GCS_URI="YOUR_GCS_BUCKET_NAME"
RAG_CORPUS_NAME="projects/YOUR_PROJECT_ID/locations/us-central1/ragCorpora/YOUR_CORPUS_ID"
